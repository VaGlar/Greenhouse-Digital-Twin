{
  "name": "Greenhouse Digital Twin",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && cd frontend && npm install",
  "postStartCommand": "bash .devcontainer/start-dev.sh",
  "forwardPorts": [8123, 5173],
  "portsAttributes": {
    "8123": {
      "label": "Backend API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  }
}
